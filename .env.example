RETELL_API_KEY=
RETELL_WEBHOOK_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=
# Run npm run auth:setup in an interactive terminal; restart the backend afterward.
ADMIN_PASSWORD_HASH=
# Required separately for authentication; auth:setup never changes this value.
SESSION_SECRET=
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_PATH=
ACTIVE_CALL_STALE_SECONDS=300
IMPORT_MAX_BYTES=1048576
IMPORT_MAX_ROWS=10000
PORT=3000
# Bind only to loopback when exposing the app through a local tunnel.
HOST=127.0.0.1
NODE_ENV=development
